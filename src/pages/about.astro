---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "About | Blog";
const pageDescription = "Learn more about my background, experience, projects, and social links.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="max-w-4xl mx-auto px-4 py-12 text-left">
    <section class="mb-14" data-pagefind-body>
      <div class="inline-block px-3 py-1 mb-4 text-xs font-semibold text-emerald-400 bg-emerald-950/50 border border-emerald-800/50 rounded-full">
        Electrical Engineering Student | Software Developer
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-100 mb-6 leading-tight">
        Moayed Elkamel
      </h1>
      <p class="text-lg text-gray-300 leading-relaxed max-w-3xl">
        I am an Electrical Engineering student in Universty of Khartoum and software developer focusing my work and experiments on systems programming, web development, and networking protocols. I primarily build lightweight tools and backend services using <span class="text-emerald-400 font-mono">Go</span>, <span class="text-emerald-400 font-mono">C</span>, and <span class="text-emerald-400 font-mono">TypeScript</span>.
      </p>
    </section>

    <section class="mb-14">
      <h2 class="text-2xl font-bold text-gray-100 mb-6 border-b border-gray-800 pb-3 flex items-center gap-2">
        <span class="text-emerald-400">#</span> Experience & Education
      </h2>

      <div class="space-y-6 relative border-l-2 border-gray-800 pl-6 ml-2">
        <div class="relative group">
          <div class="absolute -left-[31px] top-1.5 w-3 h-3 rounded-full bg-emerald-500 border-4 border-gray-950"></div>
          <div class="bg-gray-900 border border-gray-800 rounded-xl p-5 hover:border-emerald-500/50 transition-colors">
            <span class="text-xs font-mono text-emerald-400">2020 — Present</span>
            <h3 class="text-lg font-bold text-gray-100 mt-1">B.Sc. in Electrical Engineering</h3>
            <p class="text-sm text-gray-400 mb-2">University of Khartoum</p>
            <p class="text-sm text-gray-300 leading-relaxed">
              Specializing in software and systems engineering, with coursework covering microcontrollers, computer architecture, and digital signal processing.
            </p>
          </div>
        </div>

        <div class="relative group">
          <div class="absolute -left-[31px] top-1.5 w-3 h-3 rounded-full bg-emerald-500 border-4 border-gray-950"></div>
          <div class="bg-gray-900 border border-gray-800 rounded-xl p-5 hover:border-emerald-500/50 transition-colors">
            <span class="text-xs font-mono text-emerald-400">Oct 2024 — Nov 2024</span>
            <h3 class="text-lg font-bold text-gray-100 mt-1">Full-Stack Intern</h3>
            <p class="text-sm text-gray-400 mb-3">Gen AI Agency</p>
            <ul class="text-sm text-gray-300 space-y-2 list-disc list-inside leading-relaxed">
              <li>Led the development of a Shopify extension integrated with a backend email service to display checkout invitations and automate account credential delivery.</li>
              <li>Engineered an extensible email engine enabling vendors to customize templates with brand-specific styling and assets.</li>
              <li>Co-developed a community platform featuring AI-assisted category recommendations based on brand taxonomies and consumer purchase behavior.</li>
              <li>Integrated gamification elements, including rewards mechanisms and interactive challenges, to drive user community engagement.</li>
            </ul>
          </div>
        </div>

      </div>
    </section>

    <section class="mb-14">
      <h2 class="text-2xl font-bold text-gray-100 mb-6 border-b border-gray-800 pb-3 flex items-center gap-2">
        <span class="text-emerald-400">#</span> Featured Projects
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="https://github.com/neet-007/chip8_emulator" target="_blank" rel="noopener noreferrer" class="group bg-gray-900 border border-gray-800 rounded-xl p-5 hover:border-emerald-500/50 transition-all flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-start mb-2">
              <h3 class="text-lg font-bold text-gray-100 group-hover:text-emerald-400 transition-colors">Chip-8 Emulator</h3>
              <span class="text-xs font-mono bg-gray-800 text-emerald-400 px-2 py-0.5 rounded">C</span>
            </div>
            <p class="text-sm text-gray-400 leading-relaxed mb-4">
                A Chip-8 emulator written in C, featuring a simple UI built with SDL2.
            </p>
          </div>
          <span class="text-xs text-emerald-400 font-semibold flex items-center gap-1">
            View on GitHub &rarr;
          </span>
        </a>

        <a href="https://github.com/neet-007/web_socket_c" target="_blank" rel="noopener noreferrer" class="group bg-gray-900 border border-gray-800 rounded-xl p-5 hover:border-emerald-500/50 transition-all flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-start mb-2">
              <h3 class="text-lg font-bold text-gray-100 group-hover:text-emerald-400 transition-colors">WebSocket Library in C</h3>
              <span class="text-xs font-mono bg-gray-800 text-emerald-400 px-2 py-0.5 rounded">C</span>
            </div>
            <p class="text-sm text-gray-400 leading-relaxed mb-4">
                A WebSocket library written in C, featuring a simple API for sending and receiving messages, it passes the autobahn test suite.
            </p>
          </div>
          <span class="text-xs text-emerald-400 font-semibold flex items-center gap-1">
            View on GitHub &rarr;
          </span>
        </a>

        <a href="https://github.com/neet-007/glox" target="_blank" rel="noopener noreferrer" class="group bg-gray-900 border border-gray-800 rounded-xl p-5 hover:border-emerald-500/50 transition-all flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-start mb-2">
              <h3 class="text-lg font-bold text-gray-100 group-hover:text-emerald-400 transition-colors">Lox Interpreter in Go</h3>
              <span class="text-xs font-mono bg-gray-800 text-emerald-400 px-2 py-0.5 rounded">Go</span>
            </div>
            <p class="text-sm text-gray-400 leading-relaxed mb-4">
                A complete interpreter for the Lox programming language built in Go, featuring a lexer and parser and code execution.
            </p>
          </div>
          <span class="text-xs text-emerald-400 font-semibold flex items-center gap-1">
            View on GitHub &rarr;
          </span>
        </a>

        <a href="https://github.com/neet-007/text_editor_c" target="_blank" rel="noopener noreferrer" class="group bg-gray-900 border border-gray-800 rounded-xl p-5 hover:border-emerald-500/50 transition-all flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-start mb-2">
              <h3 class="text-lg font-bold text-gray-100 group-hover:text-emerald-400 transition-colors">Text Editor in C</h3>
              <span class="text-xs font-mono bg-gray-800 text-emerald-400 px-2 py-0.5 rounded">C</span>
            </div>
            <p class="text-sm text-gray-400 leading-relaxed mb-4">
                A simple vim-like text editor written in C, featuring a basic UI and syntax highlighting.
            </p>
          </div>
          <span class="text-xs text-emerald-400 font-semibold flex items-center gap-1">
            View on GitHub &rarr;
          </span>
        </a>
      </div>
    </section>

    <section>
      <h2 class="text-2xl font-bold text-gray-100 mb-6 border-b border-gray-800 pb-3 flex items-center gap-2">
        <span class="text-emerald-400">#</span> Connect & Socials
      </h2>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <a href="https://github.com/neet-007" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 p-3 bg-gray-900 border border-gray-800 rounded-lg text-gray-300 hover:text-emerald-400 hover:border-emerald-500/50 transition-colors">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          <span class="font-medium text-sm">GitHub</span>
        </a>

        <a href="https://x.com/null_dev_66" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 p-3 bg-gray-900 border border-gray-800 rounded-lg text-gray-300 hover:text-emerald-400 hover:border-emerald-500/50 transition-colors">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          <span class="font-medium text-sm">Twitter / X</span>
        </a>

        <a href="https://linkedin.com/in/moayed-elkamel" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 p-3 bg-gray-900 border border-gray-800 rounded-lg text-gray-300 hover:text-emerald-400 hover:border-emerald-500/50 transition-colors">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          <span class="font-medium text-sm">LinkedIn</span>
        </a>

        <a href="mailto:moayedeffect@gmail.com" class="flex items-center justify-center gap-2 p-3 bg-gray-900 border border-gray-800 rounded-lg text-gray-300 hover:text-emerald-400 hover:border-emerald-500/50 transition-colors">
          <svg class="w-5 h-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <span class="font-medium text-sm">Email</span>
        </a>
      </div>
    </section>

  </main>
</BaseLayout>
